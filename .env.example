# Copy this file to .env and fill in the values. .env is git-ignored; never commit real credentials.

# Application under test
RBAC_BASE_URL=https://sm-rbac-dashboard-staging.azurewebsites.net/

# Admin account used to log in
RBAC_EMAIL=your.name@sunmobility.com
RBAC_PASSWORD=change-me

# Test data (optional - these are the defaults)
# Two existing test users that the suite may edit, disable/enable and assign roles to
RBAC_TEST_USER_ID=SUNMF00000630
RBAC_TEST_USER2_ID=SUNMF00000629
# An existing application with at least one page
RBAC_EXISTING_APP=SM_SERVICE
# An existing application with no roles
RBAC_EMPTY_APP=PW_AUTO_APP_1006

# Summary email after a run (npm run test:bdd:mail / npm run mail:report)
# SendGrid (preferred when set): API key from SendGrid. MAIL_FROM must be a sender verified in SendGrid,
# e.g. MAIL_FROM=SMARTNETWORK@sunmobility.com. MAIL_TO / MAIL_CC: comma-separated addresses.
SENDGRID_API_KEY=
# Leave SMTP_HOST empty to only save the email to reports/test-summary.eml (nothing is sent).
# Office 365 example: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Comma-separated lists
MAIL_TO=
MAIL_CC=
# Largest Allure report attachment in MB; a bigger report is not attached (its path is given instead)
MAIL_MAX_ATTACHMENT_MB=18
# How many failed-test screenshots to show inline in the email
MAIL_MAX_SCREENSHOTS=10
# Lowest HTTP status reported as an API error in the email (500 = only 5xx; 4xx such as 400/422 are ignored)
MAIL_API_MIN_STATUS=500
